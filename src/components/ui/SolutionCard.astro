---
import { Picture } from 'astro:assets';
import Icon, { type IconName } from './Icon.astro';
import { media } from '../../lib/media';
import { solutionUrl, type Locale } from '../../i18n';
import type { Solution } from '../../lib/content';

interface Props {
  solution: Solution;
  locale: Locale;
  index: number;
  cta: string;
  headingLevel?: 'h2' | 'h3';
  tone?: 'light' | 'dark';
}

const { solution, locale, index, cta, headingLevel: H = 'h3', tone = 'light' } = Astro.props;
const { data } = solution;
const href = solutionUrl(locale, data.slug);
const dark = tone === 'dark';
---

<article
  data-spotlight
  class:list={[
    'group relative flex h-full flex-col overflow-hidden rounded-3xl transition-[box-shadow,transform] duration-500 ease-(--ease-out-expo) focus-within:ring-2 focus-within:ring-signal hover:-translate-y-1',
    dark ? 'bg-ink-900 text-white ring-1 ring-white/8' : 'bg-white text-ink-950 shadow-[0_1px_0_0_rgb(0_0_0/0.06)] hover:shadow-[0_30px_60px_-30px_rgb(0_0_0/0.35)]',
  ]}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-ink-800">
    <Picture
      src={media(data.cover)}
      alt=""
      formats={['avif', 'webp']}
      widths={[400, 600, 820]}
      sizes="(min-width: 1280px) 30vw, (min-width: 768px) 45vw, 100vw"
      class="size-full object-cover transition-transform duration-[1.4s] ease-(--ease-out-expo) group-hover:scale-[1.06]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink-950/70 via-transparent to-transparent"></div>
    <span class="absolute top-4 left-4 font-mono text-xs font-semibold tracking-widest text-white">
      {String(index + 1).padStart(2, '0')}
    </span>
    <span
      class="absolute bottom-4 left-4 grid size-12 place-items-center rounded-2xl bg-signal text-ink-950 shadow-lg transition-transform duration-700 ease-(--ease-out-expo) group-hover:rotate-[-8deg]"
    >
      <Icon name={data.key as IconName} class="size-6" />
    </span>
  </div>
  <div class="flex flex-1 flex-col p-6 lg:p-7">
    <H class="text-h3 font-bold">
      <a href={href} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">
        {data.title}
      </a>
    </H>
    <p class:list={['mt-3 flex-1 leading-relaxed', dark ? 'text-ink-300' : 'text-ink-600']}>{data.tagline}</p>
    <p
      class:list={['mt-6 inline-flex items-center gap-2 text-sm font-semibold', dark ? 'text-signal' : 'text-signal-ink']}
      aria-hidden="true"
    >
      {cta}
      <Icon name="arrow-right" class="size-4 transition-transform duration-500 group-hover:translate-x-1.5" />
    </p>
  </div>
  <div
    class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    style="background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgb(240 125 0 / 0.10), transparent 60%)"
  >
  </div>
</article>
