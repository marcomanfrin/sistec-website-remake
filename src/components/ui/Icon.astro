---
/**
 * Set di icone lineari coerente (24×24, tratto 1.5). Decorative per default (aria-hidden):
 * il nome accessibile va sempre fornito dall'elemento interattivo che le contiene.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'svg'>, 'name'> {
  name: IconName;
  class?: string;
  size?: number;
  strokeWidth?: number;
  title?: string;
}

export type IconName = keyof typeof paths;

const paths = {
  'arrow-right': '<path d="M4 12h16M14 6l6 6-6 6"/>',
  'arrow-left': '<path d="M20 12H4M10 6l-6 6 6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
  'arrow-down': '<path d="M12 4v16M6 14l6 6 6-6"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  'chevron-left': '<path d="m15 6-6 6 6 6"/>',
  'chevron-right': '<path d="m9 6 6 6-6 6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  minus: '<path d="M5 12h14"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  menu: '<path d="M4 8h16M4 16h16"/>',
  play: '<path d="M8 5.5v13l11-6.5z" fill="currentColor" stroke="none"/>',
  pause: '<path d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor" stroke="none"/>',
  download: '<path d="M12 4v11M7 10l5 5 5-5M5 20h14"/>',
  file: '<path d="M14 3H6.5A1.5 1.5 0 0 0 5 4.5v15A1.5 1.5 0 0 0 6.5 21h11a1.5 1.5 0 0 0 1.5-1.5V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3.5 6 8.5 7 8.5-7"/>',
  phone:
    '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  'map-pin': '<path d="M12 21s-7-6.2-7-11.5a7 7 0 1 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  external: '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  upload: '<path d="M12 16V4M7 9l5-5 5 5M5 20h14"/>',
  alert: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.01"/>',
  linkedin:
    '<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.06c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.65 4.77 6.1V21h-4v-5.1c0-1.22-.02-2.78-1.7-2.78-1.7 0-1.96 1.33-1.96 2.7V21h-4z" fill="currentColor" stroke="none"/>',
  youtube:
    '<path d="M21.6 7.2a2.5 2.5 0 0 0-1.77-1.77C18.27 5 12 5 12 5s-6.27 0-7.83.43A2.5 2.5 0 0 0 2.4 7.2C2 8.76 2 12 2 12s0 3.24.4 4.8a2.5 2.5 0 0 0 1.77 1.77C5.73 19 12 19 12 19s6.27 0 7.83-.43a2.5 2.5 0 0 0 1.77-1.77C22 15.24 22 12 22 12s0-3.24-.4-4.8zM10 15V9l5.2 3z" fill="currentColor" stroke="none"/>',
  // Icone delle soluzioni
  software:
    '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8.5 20h7M12 16v4"/><path d="m12 6.8 3 1.7v3.4l-3 1.7-3-1.7V8.5z"/><path d="M12 10.2v3.4M9 8.5l3 1.7 3-1.7"/>',
  'integrated-lines':
    '<rect x="2.5" y="15" width="19" height="4" rx="2"/><path d="M6.5 17h.01M12 17h.01M17.5 17h.01"/><rect x="4.5" y="8" width="4" height="4" rx=".5"/><rect x="15.5" y="8" width="4" height="4" rx=".5"/><path d="M8.5 10h7M12 10V4.5M10 4.5h4"/>',
  welding:
    '<path d="m4 20 6.5-6.5"/><path d="m10.5 13.5 3-3 2 2-3 3z"/><path d="m15.5 12.5 2-2"/><path d="M18.5 3.5v2.2M22 7h-2.2M20.9 4.6l-1.5 1.5M17.2 8.8l1.2-1.2"/>',
  palletizing:
    '<rect x="4" y="11" width="7" height="6" rx=".5"/><rect x="13" y="11" width="7" height="6" rx=".5"/><rect x="8.5" y="4.5" width="7" height="6.5" rx=".5"/><path d="M2.5 19.5h19M5 19.5V21M12 19.5V21M19 19.5V21"/>',
  'laser-sorting':
    '<path d="M12 2.5v5"/><path d="M9.8 7.5h4.4L12 10.8z"/><rect x="3" y="13" width="18" height="8" rx="1"/><circle cx="8" cy="17" r="2"/><rect x="13" y="15" width="5" height="4" rx=".5"/>',
  handling:
    '<path d="M12 2.5V7M7.5 7h9"/><path d="M8 7v5.5l2 3M16 7v5.5l-2 3"/><rect x="9.5" y="16.5" width="5" height="4.5" rx=".5"/>',
  bending:
    '<path d="M4 3.5h16v3.5H4z"/><path d="M12 7v2.5"/><path d="M9.8 9.5h4.4L12 12.8z"/><path d="m2.5 20.5 6-5h7l6 5"/>',
} as const;

const { name, class: className, size = 24, strokeWidth = 1.5, title, ...rest } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  focusable="false"
  {...rest}
>
  {title && <title>{title}</title>}
  <Fragment set:html={paths[name]} />
</svg>
