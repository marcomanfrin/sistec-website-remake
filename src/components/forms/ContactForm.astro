---
import FormShell from './FormShell.astro';
import Field from './Field.astro';
import Consent from './Consent.astro';
import { useDict, routes, type Locale } from '../../i18n';
import { formEndpoints } from '../../data/site';

interface Props {
  locale: Locale;
  labelledby?: string;
}

const { locale, labelledby } = Astro.props;
const t = useDict(locale);
const f = t.forms;
const [privacyBefore, privacyAfter] = f.privacyConsent.split('{link}');
---

<FormShell
  locale={locale}
  name="contact"
  endpoint={formEndpoints.contact}
  submitLabel={f.send}
  successMessage={f.success}
  labelledby={labelledby}
>
  <div class="grid gap-6 sm:grid-cols-2">
    <Field name="firstName" label={f.firstName} required autocomplete="given-name" requiredLabel={f.required} />
    <Field name="lastName" label={f.lastName} required autocomplete="family-name" requiredLabel={f.required} />
    <Field name="email" type="email" label={f.email} required autocomplete="email" requiredLabel={f.required} />
    <Field name="phone" type="tel" label={f.phone} autocomplete="tel" requiredLabel={f.required} />
    <Field name="company" label={f.company} autocomplete="organization" requiredLabel={f.required} />
    <Field name="country" label={f.country} required autocomplete="country-name" requiredLabel={f.required} />
  </div>
  <Field name="message" type="textarea" label={f.message} required rows={6} requiredLabel={f.required} />
  <Consent name="privacy" required requiredLabel={f.required}>
    {privacyBefore}<a href={routes.privacy[locale]} class="font-semibold underline underline-offset-2" target="_blank" rel="noopener">{f.privacyLink}<span class="sr-only"> {t.a11y.opensNewTab}</span></a>{privacyAfter}
  </Consent>
  <Consent name="marketing" requiredLabel={f.required}>{f.marketingConsent}</Consent>
</FormShell>
