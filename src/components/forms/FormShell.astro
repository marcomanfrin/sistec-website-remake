---
import Icon from '../ui/Icon.astro';
import { useDict, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  name: 'contact' | 'careers' | 'newsletter';
  endpoint: string;
  submitLabel: string;
  successMessage: string;
  tone?: 'light' | 'dark';
  multipart?: boolean;
  class?: string;
  labelledby?: string;
}

const { locale, name, endpoint, submitLabel, successMessage, tone = 'light', multipart = false, class: className, labelledby } = Astro.props;
const t = useDict(locale);
const dark = tone === 'dark';

const messages = {
  ...t.forms.errors,
  summary: t.forms.errorSummary,
  summaryOne: t.forms.errorSummaryOne,
  sending: t.forms.sending,
  success: successMessage,
  error: t.forms.error,
  notConfigured: t.forms.notConfigured,
};
---

<form
  class:list={['grid gap-6', !dark && 'on-light', className]}
  method="post"
  action={endpoint || undefined}
  enctype={multipart ? 'multipart/form-data' : undefined}
  novalidate
  data-form={name}
  data-messages={JSON.stringify(messages)}
  aria-labelledby={labelledby}
>
  <div
    class:list={['hidden rounded-2xl p-5 [&[data-open]]:block', dark ? 'bg-red-950/60 text-red-100 ring-1 ring-red-400/50' : 'bg-red-50 text-red-900 ring-1 ring-red-700/30']}
    tabindex="-1"
    data-error-summary
  >
    <p class="flex items-center gap-2 font-semibold" data-summary-title>
      <Icon name="alert" class="size-5" />
      <span></span>
    </p>
    <ul class="mt-3 list-disc space-y-1 pl-10 text-sm" data-summary-list></ul>
  </div>

  <p class:list={['text-sm', dark ? 'text-ink-300' : 'text-ink-600']}>{t.forms.requiredNote}</p>

  <slot />

  <!-- Honeypot anti-spam: invisibile e ignorato dalle tecnologie assistive -->
  <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
    <label for={`hp-${name}`}>Lascia vuoto</label>
    <input id={`hp-${name}`} type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="form" value={name} />
  <input type="hidden" name="lang" value={locale} />

  <div class="flex flex-wrap items-center gap-5">
    <button type="submit" class:list={['btn', dark ? 'btn-primary' : 'btn-dark', 'px-8']} data-submit>
      <span data-submit-label>{submitLabel}</span>
      <Icon name="arrow-right" class="btn-arrow" />
    </button>
    <p role="status" aria-live="polite" class:list={['text-sm font-medium', dark ? 'text-white' : 'text-ink-950']} data-form-status></p>
  </div>
</form>

<script>
  import { initForms } from '../../scripts/forms';
  initForms();
</script>
