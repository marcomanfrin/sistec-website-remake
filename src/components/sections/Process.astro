---
import { Picture } from 'astro:assets';
import SectionHeader from '../ui/SectionHeader.astro';
import { media } from '../../lib/media';

interface Props {
  eyebrow: string;
  title: string;
  steps: { title: string; text: string }[];
  imageAlt?: string;
}

const { eyebrow, title, steps } = Astro.props;
---

<section class="bg-paper py-24 lg:py-36" aria-labelledby="process-title">
  <div class="container-x grid gap-16 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-[calc(var(--header-h)+3rem)]">
        <SectionHeader eyebrow={eyebrow} title={title} id="process-title" />
        <div class="relative mt-12 hidden aspect-[4/5] max-w-md overflow-hidden rounded-3xl bg-ink-800 lg:block" data-reveal="clip">
          <Picture
            src={media('2026/05/sistec-come-lavoriamo.jpg')}
            alt=""
            formats={['avif', 'webp']}
            widths={[431]}
            class="parallax-y size-full object-cover"
          />
        </div>
      </div>
    </div>
    <div class="relative lg:col-span-6 lg:col-start-7">
      <span class="absolute top-4 bottom-4 left-[1.6875rem] w-px bg-ink-200" aria-hidden="true"></span>
      <span class="line-fill absolute top-4 bottom-4 left-[1.6875rem] w-px bg-signal" aria-hidden="true"></span>
      <ol class="relative">
      {
        steps.map((s, i) => (
          <li class="relative grid grid-cols-[3.5rem_1fr] gap-6 pb-16 last:pb-0 lg:pb-24" data-reveal style={`--d:${i * 60}`}>
            <span class="relative z-10 grid size-14 place-items-center rounded-full bg-ink-950 font-mono text-sm font-semibold text-signal ring-8 ring-paper">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="pt-2">
              <h3 class="text-h3 font-bold text-ink-950">{s.title}</h3>
              <p class="mt-4 max-w-xl text-[1.0625rem] leading-relaxed text-ink-600">{s.text}</p>
            </div>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>
