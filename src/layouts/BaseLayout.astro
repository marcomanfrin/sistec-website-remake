---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ConsentManager from '../components/layout/ConsentManager.astro';
import { useDict, htmlLang, ogLocale, withBase, type Locale, type Alternates } from '../i18n';
import { company } from '../data/site';
import ogDefault from '../assets/brand/og-default.jpg';

export interface Crumb {
  label: string;
  href: string;
}

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  alternates: Alternates;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: Crumb[];
  published?: Date;
}

const {
  locale,
  title,
  description,
  alternates,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  jsonLd = [],
  breadcrumbs,
  published,
} = Astro.props;

const t = useDict(locale);
const site = Astro.site!;
const fullTitle = title ? t.meta.titleTemplate.replace('%s', title) : t.meta.defaultTitle;
const metaDescription = description ?? t.meta.defaultDescription;
const canonical = new URL(Astro.url.pathname, site).href;

const og = await getImage({ src: image ?? ogDefault, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, site).href;

const orgId = `${site.origin}/#organization`;
const baseLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': orgId,
    name: company.name,
    alternateName: 'SISTEC',
    url: `${site.origin}/`,
    logo: `${site.origin}/brand/sistec-logo.png`,
    email: company.email,
    telephone: company.phone,
    faxNumber: company.fax,
    vatID: `IT${company.vat}`,
    address: {
      '@type': 'PostalAddress',
      streetAddress: company.street,
      postalCode: company.postalCode,
      addressLocality: company.city,
      addressRegion: company.province,
      addressCountry: company.country,
    },
    parentOrganization: { '@type': 'Organization', name: company.parent.name, url: company.parent.url },
    sameAs: [company.social.linkedin, company.social.youtube],
  },
];

if (breadcrumbs?.length) {
  baseLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: new URL(c.href, site).href,
    })),
  });
}

const ld = [...baseLd, ...jsonLd];
---

<!doctype html>
<html lang={htmlLang[locale]} dir="ltr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {(noindex || import.meta.env.PUBLIC_NOINDEX === 'true') && <meta name="robots" content="noindex, follow" />}

    {
      Object.entries(alternates).map(([l, href]) => (
        <link rel="alternate" hreflang={l} href={new URL(href, site).href} />
      ))
    }
    {alternates.it && <link rel="alternate" hreflang="x-default" href={new URL(alternates.it, site).href} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="SISTEC" />
    <meta property="og:title" content={title ?? t.meta.defaultTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {
      Object.keys(alternates)
        .filter((l) => l !== locale)
        .map((l) => <meta property="og:locale:alternate" content={ogLocale[l as Locale]} />)
    }
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? 'SISTEC – Driven by Automation, Defined by Robotics'} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0d0e0f" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only-focusable fixed top-3 left-3 z-[100] rounded-full bg-signal px-5 py-3 font-semibold text-ink-950 shadow-lg"
    >
      {t.a11y.skipToContent}
    </a>
    <a
      href="#page-footer"
      class="sr-only-focusable fixed top-3 left-3 z-[100] rounded-full bg-signal px-5 py-3 font-semibold text-ink-950 shadow-lg"
    >
      {t.a11y.skipToFooter}
    </a>

    <ConsentManager locale={locale} />
    <Header locale={locale} alternates={alternates} />

    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>

    <slot name="before-footer" />
    <Footer locale={locale} />

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
